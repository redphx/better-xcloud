                  "activationType": "exclusive"
                },
                "scale": 1
              }
            ],
            [
              {
                "type": "joystick",
                "axis": {
                  "input": "axisXY",
                  "output": "leftJoystick",
                  "deadzone": {
                    "threshold": 0.05,
                    "radial": true
                  }
                },
                "action": "leftTrigger",
                "styles": {
