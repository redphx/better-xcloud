              "action": "leftThumb",
              "relative": false,
              "actionThreshold": 2,
              "styles": {
                "default": {
                  "knob": {
                    "faceImage": {
                      "type": "icon",
                      "value": "walk"
                    }
                  }
                },
                "activated": {
                  "knob": {
                    "faceImage": {
                      "type": "icon",
                      "value": "sprint"
                    }
                  }
                }
              }
            }
          ],
          "outer": [
            [
              {
                "type": "touchpad",
                "axis": {
                  "input": "axisXY",
                  "output": "leftJoystick",
                  "sensitivity": 5,
                  "deadzone": {
                    "threshold": 0,
                    "radial": true
                  }
                },
                "renderAsButton": true,
                "action": [
                  "rightTrigger"
                ],
                "styles": {
                  "default": {
                    "faceImage": {
                      "type": "icon",
                      "value": "fire"
                    }
                  }
                }
              }
            ],
            null,
