{
  "schema_version": 1,
  "layouts": {
    "custom": {
      "name": "Custom",
      "author": "Kode-Z",
      "content": {
        "layers": {
          "qWatch": {
            "right": {
              "outer": [
                null,
                [
                  {
                    "type": "button",
                    "action": "gamepadB"
                  },
                  null
                ],
                [
                  {
                    "type": "button",
                    "action": "gamepadA"
                  },
                  null
                ],
                [
                  {
                    "type": "button",
                    "action": "gamepadX"
                  },
                  null
                ],
                [
                  {
                    "type": "button",
                    "action": "gamepadY"
                  },
                  null
                ]
              ]
            }
          }
        },
        "left": {
          "inner": [
            {
              "type": "joystick",
              "axis": {
                "input": "axisXY",
                "output": "leftJoystick"
              }
            }
          ],
          "outer": [
            null,
            null,
            [
              {
                "type": "directionalPad",
                "interaction": {
                  "activationType": "exclusive"
                }
              }
            ],
            [
              {
                "type": "button",
                "action": [
                  "leftBumper",
                  {
                    "type": "layer",
                    "target": "qWatch"
                  }
                ],
                "styles": {
                  "default": {
                    "faceImage": {
                      "type": "icon",
                      "value": "stopwatch"
                    }
                  }
                },
                "toggle": "true"
              }
            ],
            [
              {
                "type": "joystick",
                "axis": {
                  "input": "axisXY",
                  "output": "leftJoystick",
                  "deadzone": {
                    "threshold": 0.05,
                    "radial": true
                  }
                },
                "action": "leftTrigger",
                "styles": {
                  "default": {
                    "knob": {
                      "faceImage": {
                        "type": "icon",
                        "value": "aim"
                      },
                      "background": {
                        "type": "color",
                        "value": "#ffffff",
                        "opacity": 0.1
                      },
                      "stroke": {
                        "opacity": 0.1
                      }
                    }
                  }
                }
              }
            ]
          ]
        },
        "right": {
          "inner": [
            {
              "type": "joystick",
              "axis": {
                "input": "axisXY",
                "output": "rightJoystick"
              }
            }
          ],
          "outer": [
            [
              {
                "type": "touchpad",
                "axis": {
                  "input": "axisXY",
                  "output": "rightJoystick",
                  "sensitivity": 5,
                  "deadzone": {
                    "threshold": 0,
                    "radial": true
                  }
                },
                "renderAsButton": true,
                "action": [
                  "rightBumper"
                ],
                "styles": {
                  "default": {
                    "faceImage": {
                      "type": "icon",
                      "value": "rightBumper"
                    }
                  }
                }
              },
              {
                "type": "button",
                "action": "leftThumb"
              },
              {
                "type": "button",
                "action": "rightThumb",
                "styles": {
                  "default": {
                    "faceImage": {
                      "type": "icon",
                      "value": "crouch"
                    }
                  }
                }
              }
            ],
            {
              "type": "button",
              "action": "gamepadB",
              "styles": {
                "default": {
                  "faceImage": {
                    "type": "icon",
                    "value": "reload"
                  }
                }
              }
            },
            {
              "type": "button",
              "action": "gamepadX",
              "pullAction": {
                "type": "segmented",
                "items": [
                  "rightBumper",
                  "gamepadA"
                ]
              },
              "styles": {
                "default": {
                  "faceImage": {
                    "type": "icon",
                    "value": "punch"
                  },
                  "pullIndicator": [
                    {
                      "opacity": 0.3
                    },
                    {
                      "opacity": 0.3
                    }
                  ]
                },
                "idle": {
                  "pullIndicator": [
                    {
                      "opacity": 0.0
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "action": "gamepadA"
            },
            {
              "type": "touchpad",
              "axis": {
                "input": "axisXY",
                "output": "rightJoystick",
                "sensitivity": 5,
                "deadzone": {
                  "threshold": 0,
                  "radial": true
                }
              },
              "renderAsButton": true,
              "action": [
                "rightTrigger"
              ],
              "styles": {
                "default": {
                  "faceImage": {
                    "type": "icon",
                    "value": "fire"
                  }
                }
              }
            },
            [
              {
                "type": "button",
                "action": "gamepadY",
                "styles": {
                  "default": {
                    "faceImage": {
                      "type": "icon",
                      "value": "interact"
                    }
                  }
                }
              },
              null
            ]
          ]
        },
        "upper": {
          "right": [
            {
              "type": "button",
              "action": "menu"
            },
            {
              "type": "button",
              "action": "view",
              "styles": {
                "default": {
                  "faceImage": {
                    "type": "icon",
                    "value": "notebook"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}